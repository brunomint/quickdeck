{
  "name": "quickdeck",
  "version": "1.0.0",
  "description": "Painel de atalhos remoto (celular -> computador) via rede local.",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:sidecar:win": "pkg . --targets node18-win-x64 --output src-tauri/binaries/servidor-x86_64-pc-windows-msvc.exe",
    "build:sidecar:mac": "pkg . --targets node18-macos-x64 --output src-tauri/binaries/servidor-universal-apple-darwin",
    "build:sidecar:linux": "pkg . --targets node18-linux-x64 --output src-tauri/binaries/servidor-x86_64-unknown-linux-gnu"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "atalhos.default.json"
    ]
  }
}
