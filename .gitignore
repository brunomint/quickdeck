# Dependências instaladas via npm — reinstaláveis com 'npm install'
node-js/node_modules/

# Build do app nativo (Tauri) — pode ser gigante e é gerado a partir do código
node-js/src-tauri/target/
node-js/src-tauri/gen/schemas/

# Executáveis empacotados (.exe, .deb, .rpm, .AppImage etc.) — artefatos de
# build, não código-fonte. Vão como anexo nas Releases do GitHub, não no git.
node-js/dist/
instalador-linux/*.deb
instalador-linux/*.rpm
instalador-linux/*.AppImage

# Fotos de referência/inspiração — não fazem parte do projeto em si
fotos/

# Arquivos de sistema/editor
.DS_Store
*.log
